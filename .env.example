# ── DentaCare cloud config ────────────────────────────────────────────────
# Copy this file to ".env" and paste your Supabase project values.
# Find them in:  Supabase Dashboard → Project Settings → API
#
# Production requires these values so patient records stay in the account.
# Device-only demo storage is disabled by default. Developers may explicitly
# opt into it while running `npm run dev` with VITE_ENABLE_LOCAL_MODE=true.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# VITE_ENABLE_LOCAL_MODE=true

# Desktop builds call payment functions over HTTPS (web uses its own origin).
# VITE_API_BASE_URL=https://dentalcloud.pages.dev
