# ── DentaCare cloud config ────────────────────────────────────────────────
# Copy this file to ".env" and paste your Supabase project values.
# Find them in:  Supabase Dashboard → Project Settings → API
#
# Leave .env empty / missing to run the app in LOCAL (offline) mode.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Server-only SMS hook secrets. Configure these in Cloudflare Pages or Netlify;
# never prefix them with VITE_ and never commit real values.
TEXTBELT_API_KEY=YOUR-Textbelt-key
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_YOUR-base64-hook-secret
